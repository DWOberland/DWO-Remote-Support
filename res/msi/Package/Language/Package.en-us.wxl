	<String Id="AR_Comment" Value="DWO Remote Client" />

	<String Id="F_App" Value="DWO Remote Client" />
	<String Id="F_App_Desc" Value="DWO Remote Client - Main program installation." />

	<String Id="SC_Uninstall" Value="Uninstall DWO Remote Client" />
